{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hdcsnags.github.io/planet-parade/schema/pack.schema.json",
  "title": "Planet Parade content pack",
  "description": "One strand's ladder of levels. Every fact needs a source URL; every language line records who reviewed it.",
  "type": "object",
  "required": ["id", "strand", "station", "order", "name_key", "levels"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "strand": { "enum": ["number", "logic", "science", "language"] },
    "station": { "enum": ["mercury", "venus", "earth", "moon", "mars", "jupiter", "saturn", "uranus", "neptune"] },
    "order": { "type": "integer", "minimum": 1 },
    "name_key": { "type": "string" },
    "levels": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/level" } }
  },
  "additionalProperties": false,
  "definitions": {
    "level": {
      "type": "object",
      "required": ["id", "band", "skill", "objective", "template", "params", "mastery"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*[.][0-9]+$" },
        "band": { "enum": ["2-3", "4-5", "6-7"] },
        "skill": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "objective": { "type": "string", "minLength": 8, "description": "Parent-facing capability, e.g. 'Counts out up to 5 things'." },
        "template": { "type": "string" },
        "params": { "type": "object" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/item" } },
        "generator": { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["random"] } } },
        "mastery": {
          "type": "object", "required": ["window", "need", "struggle"],
          "properties": { "window": { "type": "integer", "minimum": 1 }, "need": { "type": "integer", "minimum": 1 }, "struggle": { "type": "integer", "minimum": 1 } },
          "additionalProperties": false
        }
      },
      "oneOf": [{ "required": ["items"] }, { "required": ["generator"] }],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "prompt": { "type": "string", "description": "i18n key of the spoken prompt" },
        "answer": {},
        "fact": { "type": "string", "description": "i18n key of a fact; requires `source`" },
        "source": { "type": "string", "format": "uri", "pattern": "^https://" },
        "i18n": { "type": "array", "items": { "type": "string" } },
        "reviewed_by": {
          "type": "object",
          "properties": { "en": { "type": ["string", "null"] }, "fr": { "type": ["string", "null"] }, "fa": { "type": ["string", "null"] } },
          "additionalProperties": false
        }
      },
      "if": { "required": ["fact"] }, "then": { "required": ["source"] }
    }
  }
}
